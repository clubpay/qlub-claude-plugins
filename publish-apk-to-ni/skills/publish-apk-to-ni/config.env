# Network International SFTP — NON-SECRET connection settings for the
# publish-apk-to-ni skill. Safe to share/commit. NO PASSWORD is stored here.
#
# The SFTP password is provided at runtime via the NI_SFTP_PASSWORD environment
# variable, or entered interactively when the script prompts. It is never
# written to disk. The SFTP username can be overridden with NI_SFTP_USER.

# Teleport bastion (jump host) reached via `tsh ssh`
TSH_NODE=data-analytics-v2
TSH_USER=bi_analytics

# The SFTP server (private IP, only reachable through the tunnel)
SFTP_TARGET_HOST=10.66.107.155
SFTP_TARGET_PORT=22

# Local port the tunnel listens on (reused if already open)
LOCAL_PORT=6666

# Default SFTP username (not secret; override at runtime with NI_SFTP_USER)
SFTP_USER=qlubuser

# Where APKs go
REMOTE_DIR=/343/Inbound/APK
